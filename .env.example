# Hostname or IP of your UniFi console on the local network.
UDM_HOST=unifi.example.lan

# API key generated in the UniFi Network app:
#   Settings -> Admins & Users -> (your admin) -> Create API Key
# The key inherits that admin account's permissions. This project only ever
# issues GETs, but a read-only admin account is still the safer choice.
UNIFI_API_KEY=replace-me
